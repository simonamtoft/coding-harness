@@ -0,0 +1,17 @@
+import json
+
+
+def save_checkpoint(path, model, optimizer, step):
+    """Write model parameters, optimizer state, and the step count to `path` as JSON."""
+    state = {'step': step, 'model': model.state_dict(), 'optimizer': optimizer.state_dict()}
+    with open(path, 'w', encoding='utf-8') as handle:
+        json.dump(state, handle)
+
+
+def load_checkpoint(path, model, optimizer):
+    """Restore a checkpoint written by save_checkpoint and return its step count."""
+    with open(path, encoding='utf-8') as handle:
+        state = json.load(handle)
+    model.load_state_dict(state['model'])
+    optimizer.load_state_dict(state['optimizer'])
+    return state['step']
