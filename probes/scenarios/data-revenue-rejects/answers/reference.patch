@@ -0,0 +1,19 @@
+import unittest
+from decimal import Decimal
+
+from examples.revenue_report import parse_amount
+
+
+class ParseAmountTests(unittest.TestCase):
+    def test_accepted_formats(self):
+        self.assertEqual(parse_amount(' $1,204.50 '), Decimal('1204.50'))
+        self.assertEqual(parse_amount('($12.25)'), Decimal('-12.25'))
+        self.assertEqual(parse_amount('-0.005'), Decimal('-0.005'))
+
+    def test_rejected_formats(self):
+        for raw in ['', 'n/a', '1e3', '(1.00', '-(1.00)', '1,00']:
+            self.assertIsNone(parse_amount(raw), raw)
+
+
+if __name__ == '__main__':
+    unittest.main()
