+"""Command-line wrapper: revenue_report_cli.py INPUT OUTPUT REJECTS."""
+import argparse
+
+from revenue_report import net_revenue
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('input')
+    parser.add_argument('output')
+    parser.add_argument('rejects')
+    args = parser.parse_args()
+    net_revenue(args.input, args.output, args.rejects)
+
+
+if __name__ == '__main__':
+    main()
