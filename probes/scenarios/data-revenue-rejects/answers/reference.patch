@@ -0,0 +1,40 @@
+"""Net revenue per region from a spreadsheet sales export, with rejected rows kept aside."""
+import re
+from decimal import ROUND_HALF_UP, Decimal
+
+import petl as etl
+
+AMOUNT = re.compile(r'^(-)?(\()?\$?(\d{1,3}(?:,\d{3})+|\d+)(\.\d+)?(\))?$')
+CENT = Decimal('0.01')
+
+
+def parse_amount(raw):
+    """Return the Decimal value of ``raw``, or None when it is not a valid amount."""
+    match = AMOUNT.match(raw.strip())
+    if not match:
+        return None
+    minus, opening, whole, fraction, closing = match.groups()
+    if bool(opening) != bool(closing) or (minus and opening):
+        return None
+    value = Decimal(whole.replace(',', '') + (fraction or ''))
+    return -value if minus or opening else value
+
+
+def net_revenue(input_path, output_path, rejects_path):
+    table = etl.fromcsv(str(input_path), encoding='utf-8-sig')
+    rows = etl.addrownumbers(etl.cut(table, 'region', 'amount'), field='row')
+    totals = {}
+    rejects = [('row', 'region', 'amount')]
+    for number, region, amount in etl.data(rows):
+        value = parse_amount(amount)
+        if not region.strip() or value is None:
+            rejects.append((number, region, amount))
+            continue
+        key = region.strip().upper()
+        totals[key] = totals.get(key, Decimal(0)) + value
+    net = [('region', 'net')] + [
+        (region, str(totals[region].quantize(CENT, rounding=ROUND_HALF_UP)))
+        for region in sorted(totals)
+    ]
+    etl.tocsv(net, str(output_path), encoding='utf-8')
+    etl.tocsv(rejects, str(rejects_path), encoding='utf-8')
