+"""Aggregate local sales revenue per region with petl."""
+from decimal import Decimal
+
+import petl as etl
+
+
+def summarize(input_path, output_path):
+    """Write region,revenue totals for ``input_path`` to ``output_path``, regions sorted."""
+    table = etl.fromcsv(str(input_path), encoding='utf-8')
+    table = etl.select(table, lambda row: row['region'].strip() != '')
+    table = etl.convert(table, 'revenue', Decimal)
+    totals = etl.aggregate(table, 'region', sum, 'revenue')
+    totals = etl.convert(totals, 'value', lambda value: str(value.quantize(Decimal('0.01'))))
+    totals = etl.rename(totals, 'value', 'revenue')
+    etl.tocsv(etl.sort(totals, 'region'), str(output_path), encoding='utf-8')
